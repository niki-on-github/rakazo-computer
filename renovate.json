{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "labels": [
    "renovatebot"
  ],
  "minimumReleaseAge": "1 day",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "automerge": true,
  "automergeType": "branch",
  "customManagers": [
    {
      "description": "Apptainer .deb: version and sha256 of the release attachment",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "ARG APPTAINER_VERSION=(?<currentValue>\\S+)\\s+ARG APPTAINER_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "apptainer/apptainer",
      "datasourceTemplate": "github-release-attachments"
    }
  ],
  "packageRules": [
    {
      "description": "One commit for all GitHub Actions updates, so they trigger one build instead of cancelling each other",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    }
  ],
  "ignoreTests": true
}
