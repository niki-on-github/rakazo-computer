{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "labels": ["renovatebot"],
  "minimumReleaseAge": "1 day",
  "automerge": true,
  "automergeType": "pr",
  "customManagers": [
    {
      "description": "Apptainer .deb: version and sha256 of the release attachment",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "ARG APPTAINER_VERSION=(?<currentValue>\\S+)\\s+ARG APPTAINER_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "depNameTemplate": "apptainer/apptainer",
      "datasourceTemplate": "github-release-attachments"
    }
  ],
  "packageRules": [
    {
      "description": "The base tag must match the Rakazo app tag deployed in nixos-ai; label it so it stands out",
      "matchPackageNames": ["ghcr.io/elie222/rakazo/computer"],
      "addLabels": ["rakazo-base"]
    },
    {
      "description": "Major updates need a look",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["type/major"]
    }
  ]
}
